# Připojení k PostgreSQL databázi
DATABASE_URL=postgresql://pujcovna:pujcovna@localhost:5432/pujcovna

# Port, na kterém poběží backend server
PORT=4000

# Tajný klíč pro podepisování přihlašovacích session (cokoliv dlouhého a náhodného).
# V produkci MUSÍ být nastaven a nikdy nesdílen — bez něj by šlo padělat přihlášení.
JWT_SECRET=zmen-me-na-nahodny-retezec

# Přihlašovací účet, který se automaticky založí při prvním spuštění (npm run migrate),
# pokud uživatel s tímto jménem ještě neexistuje. Další účty zatím appka nezakládá
# přes UI — řekni si o přidání, pokud jich budeš potřebovat víc.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zmen-me

# E-mailové upozornění (nová žádost o rezervaci, týdenní přehled) — volitelné,
# appka běží normálně i bez nich (jen notifikace neposílá). Posílá se přes
# Resend (HTTPS API — cloudoví poskytovatelé jako Render běžně blokují
# odchozí SMTP porty, tomuhle se tak appka vyhne). Návod v README.
RESEND_API_KEY=
RESEND_FROM=Půjčovna <onboarding@resend.dev>
NOTIFY_EMAIL_TO=

# Tajný token pro naplánovanou úlohu (GitHub Actions), která appku jednou týdně
# "probudí" a pošle mailem přehled — viz .github/workflows/keep-alive.yml a README.
CRON_SECRET=zmen-me-na-nahodny-retezec

# Nepovinné — adresa appky, přidá se jako odkaz do týdenního přehledu mailem.
APP_URL=https://pujcovna-backend.onrender.com
